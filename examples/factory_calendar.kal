# 场景：同一产线两件事——① 巡检读数没到阈值前逐批放行；一读数超阈值当即停线。② 下个月排班：跳过试运营 14 天，再从零号起打印上岗日序号。
extern printd(x);

def batchsignal(k) 3 * k;

def qcstopline(limitbatches)
    for batch = 1, not (limitbatches < batch), 1 in
        if batchsignal(batch) < 12 then printd(batchsignal(batch))
        else break;

qcstopline(25);

printd(0 - 9102);

def warmupschedule(totalshift)
    for day = 0, day < totalshift, 1 in
        if day < 14 then continue else printd(day);

warmupschedule(31);
